From 4ace0239df63f81a5f84d149fb31d90c7d8e6897 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 16 Nov 2026 01:53:52 +0500
Subject: [PATCH] Use Prisma Accelerate pooled connection to stop 'too many
 connections' 500s

Runtime now uses PRISMA_DATABASE_URL (Accelerate) and keeps DATABASE_URL as
directUrl for db push. Fixes PrismaClientInitializationError on / and /guides/[slug].

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_012fZxYg7kpw5XKeCXyPPdyP
---
 .env.example         |  1 +
 package.json         |  1 +
 prisma/schema.prisma |  3 ++-
 src/lib/db.ts        | 28 +++++++++++-----------------
 4 files changed, 15 insertions(+), 18 deletions(-)

diff --git a/.env.example b/.env.example
index e1e6461..52db6f4 100644
--- a/.env.example
+++ b/.env.example
@@ -56,3 +56,4 @@ NEXT_PUBLIC_GA_ID=""             # Google Analytics 4, e.g. G-XXXXXXX
 NEXT_PUBLIC_TIKTOK_PIXEL_ID=""
 NEXT_PUBLIC_PINTEREST_TAG_ID=""
 FACEBOOK_DOMAIN_VERIFICATION=""  # meta tag code from Meta Business Settings > Domains
+PRISMA_DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=..."
diff --git a/package.json b/package.json
index 76792c4..d255a14 100644
--- a/package.json
+++ b/package.json
@@ -13,6 +13,7 @@
   },
   "dependencies": {
     "@prisma/client": "5.22.0",
+    "@prisma/extension-accelerate": "^1.3.0",
     "@vercel/analytics": "1.3.1",
     "jose": "5.9.6",
     "next": "14.2.15",
diff --git a/prisma/schema.prisma b/prisma/schema.prisma
index d6cf93b..5a2cca0 100644
--- a/prisma/schema.prisma
+++ b/prisma/schema.prisma
@@ -4,7 +4,8 @@ generator client {
 
 datasource db {
   provider = "postgresql"
-  url      = env("DATABASE_URL")
+  url       = env("PRISMA_DATABASE_URL") // pooled (Accelerate) for the live site
+  directUrl = env("DATABASE_URL")        // direct, used by prisma db push / migrations
 }
 
 model Product {
diff --git a/src/lib/db.ts b/src/lib/db.ts
index 9a57bf6..468079d 100644
--- a/src/lib/db.ts
+++ b/src/lib/db.ts
@@ -1,22 +1,16 @@
 import { PrismaClient } from "@prisma/client";
+import { withAccelerate } from "@prisma/extension-accelerate";
 
-// On Vercel every function instance opens its own database pool. Keep each
-// instance to ONE connection so a burst of visitors (or a redeploy) can't
-// exhaust the database's connection limit and take the whole store down.
-function dbUrl(): string | undefined {
-  const raw = process.env.DATABASE_URL;
-  if (!raw || !raw.startsWith("postgres")) return raw;
-  try {
-    const u = new URL(raw);
-    if (!u.searchParams.has("connection_limit")) u.searchParams.set("connection_limit", "1");
-    if (!u.searchParams.has("pool_timeout")) u.searchParams.set("pool_timeout", "20");
-    return u.toString();
-  } catch {
-    return raw;
-  }
+// Live traffic goes through Prisma Accelerate (PRISMA_DATABASE_URL), which pools
+// connections in front of the database. Without it every Vercel instance opened
+// its own direct connection, and a burst of visitors hit
+// "too many connections" and took pages down with 500 errors.
+// DATABASE_URL stays the direct URL and is only used for schema pushes.
+const g = globalThis as unknown as { prisma?: PrismaClient };
+
+function create(): PrismaClient {
+  return new PrismaClient().$extends(withAccelerate()) as unknown as PrismaClient;
 }
 
-const g = globalThis as unknown as { prisma?: PrismaClient };
-const url = dbUrl();
-export const prisma = g.prisma ?? new PrismaClient(url ? { datasources: { db: { url } } } : undefined);
+export const prisma = g.prisma ?? create();
 g.prisma = prisma;
-- 
