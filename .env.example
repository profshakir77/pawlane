# Database (Prisma Postgres, Neon, Supabase, etc.)
DATABASE_URL="postgresql://user:pass@host:5432/pawlane"

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_STORE_NAME="Pawlane"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Admin login
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-this-long-password"
ADMIN_SECRET="random-32+-char-string-for-signing-sessions"

# Cron protection (Vercel sends this as a Bearer token)
CRON_SECRET="another-random-string"

# Pricing rules
MARKUP_MULTIPLIER="2.5"
MIN_PROFIT_CENTS="800"

# Fulfilment: send paid orders to the supplier automatically
AUTO_FULFILL="true"

# Supplier: "mock" for local testing, "cj" for CJ Dropshipping
DEFAULT_SUPPLIER="mock"
CJ_API_KEY=""
CJ_LOGISTIC="CJPacket Ordinary"
CJ_AUTO_PAY="false"

# Google Search Console HTML-tag verification code (optional)
GOOGLE_SITE_VERIFICATION=""

# Load the 6 demo products on deploy (set to "false" once you import real ones)
SEED_DEMO="true"

# Shown on the contact, privacy, terms and returns pages
NEXT_PUBLIC_SUPPORT_EMAIL="hello@yourdomain.com"
NEXT_PUBLIC_LEGAL_NAME="Your Company Name"
RETURN_ADDRESS="Your returns address, or leave unset to email it on request"
