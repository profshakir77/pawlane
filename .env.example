# Database (Prisma Postgres, Neon, Supabase, etc.)
DATABASE_URL="postgresql://user:pass@host:5432/pawlane"

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_STORE_NAME="Wrenpaw"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Admin login
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-this-long-password"
ADMIN_SECRET="random-32+-char-string-for-signing-sessions"

# Cron protection (Vercel sends this as a Bearer token)
CRON_SECRET="another-random-string"

# Pricing rules
MARKUP_MULTIPLIER="2.5"
MIN_PROFIT_CENTS="800"

# Fulfilment: send paid orders to the supplier automatically
AUTO_FULFILL="true"

# Supplier: "mock" for local testing, "cj" for CJ Dropshipping
DEFAULT_SUPPLIER="mock"
CJ_API_KEY=""
CJ_LOGISTIC="CJPacket Ordinary"
CJ_AUTO_PAY="false"

# Google Search Console HTML-tag verification code (optional)
GOOGLE_SITE_VERIFICATION=""

# Load the 6 demo products on deploy (set to "false" once you import real ones)
SEED_DEMO="true"

# Shown on the contact, privacy, terms and returns pages
NEXT_PUBLIC_SUPPORT_EMAIL="hello@yourdomain.com"
NEXT_PUBLIC_LEGAL_NAME="Your Company Name"
RETURN_ADDRESS="Your returns address, or leave unset to email it on request"

# Payments: "safepay" (pays out to a Pakistani bank account) or "stripe".
# If unset, Safepay is used when its keys exist, otherwise Stripe.
PAYMENT_PROVIDER="safepay"
SAFEPAY_ENV="sandbox"            # "production" once approved
SAFEPAY_API_KEY=""               # public client key from the Safepay dashboard
SAFEPAY_SECRET_KEY=""            # v1 secret (signs the redirect after payment)
SAFEPAY_WEBHOOK_SECRET=""        # webhook secret; endpoint: https://yourdomain.com/api/webhooks/safepay
SAFEPAY_CURRENCY="USD"

# Ad and analytics pixels (each loads only when set)
NEXT_PUBLIC_META_PIXEL_ID=""     # Facebook + Instagram ads
NEXT_PUBLIC_GA_ID=""             # Google Analytics 4, e.g. G-XXXXXXX
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""
NEXT_PUBLIC_PINTEREST_TAG_ID=""
FACEBOOK_DOMAIN_VERIFICATION=""  # meta tag code from Meta Business Settings > Domains
